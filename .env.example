# FairRide Environment Configuration

# 1. Custom OSRM Server Base URL (Optional: points to your self-hosted OSRM container with Tamil Nadu extract)
# Example: ROUTING_BASE_URL=http://localhost:5000
ROUTING_BASE_URL=

# 2. OpenRouteService API Key (Optional: for routing and geocoding outside precomputed landmark matrix)
# Free plan: 2,000 route requests/day, 40/minute.
# Register at: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# 3. Map Tile URL for MapLibre GL JS (Optional: If empty, draws route line on a plain dark background)
# Example: VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
